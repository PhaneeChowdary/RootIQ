# Local runtime configuration
ROOTIQ_DATA_DIR=./backend/data
ROOTIQ_OLLAMA_URL=http://127.0.0.1:11434
ROOTIQ_OLLAMA_MODEL=qwen3:8b
ROOTIQ_EMBEDDING_MODEL=nomic-embed-text

# Required local sign-in credentials
ROOTIQ_AUTH_USERNAME=your-local-username
ROOTIQ_AUTH_PASSWORD=choose-a-strong-local-password
ROOTIQ_AUTH_SESSION_HOURS=8
# Optional single sign-on (OpenID Connect). Leave the issuer empty to turn it off.
ROOTIQ_OIDC_ISSUER=
ROOTIQ_OIDC_CLIENT_ID=
ROOTIQ_OIDC_CLIENT_SECRET=
ROOTIQ_OIDC_REDIRECT_URL=http://127.0.0.1:5174/api/auth/oidc/callback
ROOTIQ_OIDC_NAME=Google
ROOTIQ_OIDC_ALLOWED_DOMAINS=
ROOTIQ_OIDC_DEFAULT_ROLE=viewer

# Optional Jira Cloud escalation for approved incidents
ROOTIQ_JIRA_SITE_URL=https://your-domain.atlassian.net
ROOTIQ_JIRA_EMAIL=
ROOTIQ_JIRA_API_TOKEN=
ROOTIQ_JIRA_PROJECT_KEY=
ROOTIQ_JIRA_ISSUE_TYPE=Task
ROOTIQ_JIRA_SYNC_JQL=status != Done ORDER BY created DESC

# Optional Gmail draft creation for approved customer updates
ROOTIQ_GMAIL_CLIENT_ID=
ROOTIQ_GMAIL_CLIENT_SECRET=
ROOTIQ_GMAIL_REFRESH_TOKEN=

# Investigation agent (tool-calling model, max tool rounds per run, service log folder)
ROOTIQ_AGENT_MODEL=qwen3:8b
ROOTIQ_AGENT_MAX_STEPS=8
ROOTIQ_LOGS_DIR=./backend/seed/logs
# true: approved agent actions are logged but not sent to Gmail or Jira
ROOTIQ_AGENT_DRY_RUN=true
# Start agent runs automatically on case creation, Jira import and SLA risk (false: one-prompt analysis instead)
ROOTIQ_AGENT_AUTORUN=true
# Investigations run one at a time by default so a local model is not overloaded
ROOTIQ_AGENT_CONCURRENCY=1
ROOTIQ_AGENT_SLA_WATCH_SECONDS=60
ROOTIQ_AGENT_SLA_COOLDOWN_MINUTES=120
# Where the MCP server reaches the RootIQ API (start/check investigations)
ROOTIQ_API_URL=http://127.0.0.1:8011
# Wall-clock budget per agent-team run in seconds (0 = no limit)
ROOTIQ_AGENT_TIME_LIMIT_SECONDS=600

# Optional: Gemini as the main agent model, with the local Ollama model as an automatic backup.
# Get a key at aistudio.google.com. Leave empty to run fully local.
ROOTIQ_GEMINI_API_KEY=
ROOTIQ_GEMINI_MODEL=gemini-3.5-flash

# Grafana alerts: a long random token. Grafana sends it with each alert. Empty = alert intake is off.
ROOTIQ_ALERT_TOKEN=
# Grafana admin password (user: admin)
ROOTIQ_GRAFANA_PASSWORD=
# Grafana address for the links in RootIQ
ROOTIQ_GRAFANA_URL=http://127.0.0.1:3000

# Time zone (IANA name) for "today" of the token budgets and for the times on the website.
# Empty = this computer's zone. Service logs stay in UTC.
ROOTIQ_TIME_ZONE=America/New_York

# Security and privacy (see README: Security and privacy)
ROOTIQ_PRIVACY_MASKING=cloud
ROOTIQ_LOGIN_MAX_FAILURES=5
ROOTIQ_LOGIN_LOCK_MINUTES=15
ROOTIQ_RETENTION_BIN_DAYS=30
ROOTIQ_RETENTION_RESOLVED_DAYS=0
ROOTIQ_RETENTION_AUDIT_DAYS=0
ROOTIQ_COOKIE_SECURE=false
# ROOTIQ_SECRET_KEY=   (optional: else the app makes backend/data/secret.key)

# Production (see docs/deploy.md). Empty database URL = SQLite in backend/data.
ROOTIQ_DATABASE_URL=
ROOTIQ_AGENT_EXTERNAL_WORKERS=false
ROOTIQ_BACKUP_HOURS=24
ROOTIQ_BACKUP_KEEP=14

# Groq (optional): answers the complex agent tasks first. See README: Models by task.
ROOTIQ_GROQ_API_KEY=
ROOTIQ_GROQ_MODEL=openai/gpt-oss-120b
ROOTIQ_GROQ_DAILY_TOKENS=200000
# OpenAI (optional, paid): writes only the Code agent's patches. Daily cap in tokens; 0 = no cap
ROOTIQ_OPENAI_DAILY_TOKENS=100000
