      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "rootiq-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rootiq_agent_investigation_seconds_bucket))",
          "legendFormat": "median"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "rootiq-prometheus"
          },
          "expr": "histogram_quantile(0.9, sum by (le) (rootiq_agent_investigation_seconds_bucket))",
          "legendFormat": "90th percentile"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Model calls",
      "description": "'failed' calls went to the local backup.",
      "datasource": {
        "type": "prometheus",
        "uid": "rootiq-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
