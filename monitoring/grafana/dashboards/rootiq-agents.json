    {
      "id": 7,
      "type": "timeseries",
      "title": "ERROR lines per service (last 5 min)",
      "description": "The alert rule 'Service errors rising' fires above 3. RootIQ then opens a case and starts the agent team.",
      "datasource": {
        "type": "prometheus",
        "uid": "rootiq-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "rootiq-prometheus"
          },
          "expr": "rootiq_service_log_errors_5m",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Investigation time",
      "description": "Time from the first agent to the final analysis, across all runs.",
      "datasource": {
        "type": "prometheus",
        "uid": "rootiq-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
