          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Active",
                  "color": "green"
                },
                "1": {
                  "text": "Paused",
                  "color": "orange"
                }
